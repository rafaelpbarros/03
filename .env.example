# PostgreSQL usado pelos carregadores do ETL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=substitua_por_uma_senha_local
POSTGRES_SCHEMA=dbf_importacao

# Numero maximo de conexoes simultaneas da carga direta DBF para PostgreSQL.
POSTGRES_CONCURRENCY=4